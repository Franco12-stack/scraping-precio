# --- ePagos Credenciales ---
EPAGOS_ID_ORGANISMO=       # ID del organismo (proveído por ePagos)
EPAGOS_ID_USUARIO=         # Número de DNI / usuario del portal
EPAGOS_PASSWORD=           # Contraseña del portal
EPAGOS_HASH=               # Hash de autenticación (proveído por ePagos)
EPAGOS_CONVENIO=           # Número de convenio (proveído por ePagos)

# --- Entorno ---
# "sandbox" para pruebas, "produccion" para producción
EPAGOS_ENTORNO=sandbox
