# --- ePagos Credenciales API SOAP ---
# Todos estos valores se encuentran en el portal → Desarrolladores → API

EPAGOS_ID_ORGANISMO=20642
EPAGOS_ID_USUARIO=319372
EPAGOS_PASSWORD=<Credencial del portal — NO es la contraseña del portal web>
EPAGOS_HASH=<Hash del portal>
EPAGOS_CONVENIO=<Número de convenio del portal>

# Entorno: "produccion" o "sandbox"
EPAGOS_ENTORNO=produccion
